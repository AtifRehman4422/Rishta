DB_HOST=localhost
DB_PORT=3306
DB_NAME=humrishta_db
DB_USER=root
DB_PASSWORD=your_strong_db_password_here

PORT=3000
NODE_ENV=production
FRONTEND_URL=https://humrishta.com

# Optional: absolute path to Angular browser build (index.html folder).
# If unset, backend looks for ./public, ./frontend, or ../pk-rishta-frontend/dist/.../browser
# FRONTEND_DIST=/home/USER/humrishta/frontend

# Use a long random string (32+ characters). Never commit the real value.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# Gmail / SMTP for OTP emails (register + forgot password)
# IMPORTANT: Gmail normal password will NOT work. Use an App Password:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Hum Rishta <your_gmail@gmail.com>
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=240
OTP_MAX_ATTEMPTS=5

# Performance: concurrent DB connections (default 50 — good for hundreds of users)
DB_POOL_MAX=50

# Rate limits per IP (15 minute window)
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=15

# Max concurrent pending contact requests per user
CONTACT_REQUEST_PENDING_LIMIT=3

# Pending contact requests auto-expire after this many days with no response
CONTACT_REQUEST_PENDING_EXPIRE_DAYS=2

# Set true when behind Nginx / reverse proxy (required for rate limits + HTTPS)
TRUST_PROXY=true

# Optional: direct HTTPS on Node (production usually uses Nginx instead)
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem
