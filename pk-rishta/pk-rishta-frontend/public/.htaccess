<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Node handle API + uploads (do not rewrite these to index.html)
  RewriteRule ^api(/|$) - [L]
  RewriteRule ^uploads(/|$) - [L]

  # Existing files (JS/CSS/images) are served as-is
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
